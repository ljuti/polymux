# Development secrets for the polymux devcontainer.
#
# Copy this file to .env and fill in your Polygon.io API key.
# .env is gitignored — never commit real secrets.
#
# On boot, post-start.sh sources .env into the container shell, and
# post-create.sh installs a profile hook so every new shell exports it.
# Alternatively, set these on the host and devcontainer.json injects them
# via containerEnv (${localEnv:...}).

# Polygon.io API key (https://polygon.io)
POLYMUX_API_KEY=your_api_key_here

# API base URL (unset = defaults to https://api.polygon.io)
POLYMUX_BASE_URL=https://api.polygon.io

# S3 credentials for Flat Files bulk downloads (optional)
POLYMUX_S3_ACCESS_KEY_ID=
POLYMUX_S3_SECRET_ACCESS_KEY=
